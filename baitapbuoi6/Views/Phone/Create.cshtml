@model baitapbuoi6.Models.Phone
@{
    ViewData["Title"] = "Thêm mới";
}

<h2>Thêm điện thoại mới</h2>
<form asp-action="Create" method="post" style="max-width:400px;">
    <div class="mb-3">
        <label asp-for="ModelName">Tên máy</label>
        <input asp-for="ModelName" class="form-control" />
        <span asp-validation-for="ModelName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Brand">Hãng sản xuất</label>
        <input asp-for="Brand" class="form-control" />
        <span asp-validation-for="Brand" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Price">Giá ($)</label>
        <input asp-for="Price" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Stock">Số lượng</label>
        <input asp-for="Stock" type="number" class="form-control" />
        <span asp-validation-for="Stock" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-success">Thêm mới</button>
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>